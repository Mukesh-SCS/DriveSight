# Required (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional — canonical URL for auth emails and SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — push migrations from terminal without `supabase link`
# Supabase → Project Settings → Database → Database password
SUPABASE_DB_PASSWORD=

# Or use the full connection URI instead of SUPABASE_DB_PASSWORD
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
